# ==============================================================================
# .env.example — Template Konfigurasi Laravel
# ==============================================================================
# Di luar Docker (development lokal):
#   cp frontend/.env.example frontend/.env
#   Isi DB_HOST, DB_PORT, dll sesuai setup lokal Anda.
#
# Di dalam Docker:
#   .env dibuat OTOMATIS oleh docker/frontend/entrypoint.sh
#   dari environment variables yang didefinisikan di docker-compose.yml
# ==============================================================================

APP_NAME="HateSense ID Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (lokal non-Docker, sesuaikan dengan setup XAMPP/Laragon Anda) ────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=HateSpeech
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── FastAPI Python AI Engine ───────────────────────────────────────────────────
# Non-Docker (lokal): FASTAPI_BASE_URL=http://127.0.0.1:8080/api/v1
# Docker            : FASTAPI_BASE_URL=http://backend:8080/api/v1 (via docker-compose)
FASTAPI_BASE_URL=http://127.0.0.1:8080/api/v1
FASTAPI_TIMEOUT=60
