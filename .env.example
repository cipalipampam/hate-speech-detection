# ==============================================================================
# .env.example — Konfigurasi Environment Proyek (Docker & Orchestration)
# ==============================================================================
# File ini opsional saat menjalankan via Docker, karena docker-compose.yml sudah
# memiliki default fallback untuk semua variabel di bawah ini.
#
# Jika Anda ingin mengubah port (misal jika port 3306/8000 bentrok dengan XAMPP/aplikasi host):
#   1. Salin file ini menjadi .env:
#      PowerShell : Copy-Item .env.example .env
#      CMD        : copy .env.example .env
#      Linux/WSL  : cp .env.example .env
#   2. Ubah nilai port sesuai kebutuhan, lalu jalankan: docker compose up -d --build
# ==============================================================================

# ── Port Binding ke Windows Host ─────────────────────────────────────────────
# Port Web Portal Laravel di browser (contoh: http://localhost:8000)
FRONTEND_PORT=8000

# Port REST API FastAPI & Swagger UI Docs (contoh: http://localhost:8080/docs)
FASTAPI_PORT=8080

# Port MySQL jika diakses dari GUI host seperti DBeaver/Navicat
# (Ubah ke 3307 jika port 3306 lokal Anda sudah dipakai oleh XAMPP/MySQL service)
DB_PORT=3306


# ── Kredensial Database MySQL ────────────────────────────────────────────────
DB_ROOT_PASSWORD=rootsecret
DB_DATABASE=HateSpeech
DB_USERNAME=hatespeech_user
DB_PASSWORD=hatespeech_pass


# ── Laravel App Settings ─────────────────────────────────────────────────────
# APP_KEY akan di-generate otomatis oleh entrypoint container jika belum terisi
APP_KEY=
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=info
